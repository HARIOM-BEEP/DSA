class Solution {
public:
    void setZeroes(vector<vector<int>>& matrix) {
        int m=matrix.size();
        int n=matrix[0].size();
        vector<bool> ans(m,false);
        vector<bool> ans1(n,false);

        for(int i=0; i<m; i++){
            for(int j=0; j<n; j++){
                if(matrix[i][j]==0){
                    ans[i]=true;
                    ans1[j]=true;
                    
                }
            }
        }
        for(int i=0; i<m; i++){
            if(ans[i]==true){
                for(int j=0; j<n; j++){
                    matrix[i][j]=0;
                }
            }
            
        }
        for(int i=0; i<n; i++){
            if(ans1[i]==true){
                for(int j=0; j<m; j++){
                    matrix[j][i]=0;
                }
            }
        }
        
    }
};
