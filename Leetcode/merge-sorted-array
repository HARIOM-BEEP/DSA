class Solution {
public:
    void merge(vector<int>& nums1, int m, vector<int>& nums2, int n) {
    vector<int> nums3(m+n);
    int j=0;
    int i=0;
    for(int k=0; k<m+n; k++){
        if(i==m){
            nums3[k]=nums2[j];
            j++;
        }
        else if (j==n){
            nums3[k]=nums1[i];
            i++;
        }
        else if(nums1[i]<nums2[j]){
            nums3[k]=nums1[i];
            i++;
        }

        else if(nums1[i]==nums2[j]){
            nums3[k]=nums1[i];
            nums3[k+1]=nums2[j];
            i++;
            j++;
            k++;
        }
        else{
            nums3[k]=nums2[j];
            j++;
        }
    } 
    nums1=nums3;  
    
    }
    
};
