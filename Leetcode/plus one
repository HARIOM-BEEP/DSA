class Solution {
public:
    vector<int> plusOne(vector<int>& nums) {
        vector<int> ans;
        int n=nums.size();
        int carry=1;
        
        for(int i=n-1; i>=0; i--){
            
            if(nums[i]==9){
                
                if(carry==1){
                ans.push_back(0);
                carry=1;
                }
                else{
                    ans.push_back(9);
                }
                if(i==0 && carry==1){
                    ans.push_back(1);
                }
                
            }

            else{
                ans.push_back(nums[i]+carry);
                carry=0;
            }
            
        }
        reverse(ans.begin(), ans.end());
        return ans;
    }
};
