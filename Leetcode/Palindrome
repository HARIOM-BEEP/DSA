class Solution {
public:
    bool isPalindrome(int x) {
        int nums1=0;
        long long nums2=0;
        int n=x;
        for(int i=0; n>0; i++){
            
            nums1=n%10;
            nums2=nums2*10+nums1;
            n=n/10;
        }
        if (nums2==x) return true;
        else return false;
    }
};
