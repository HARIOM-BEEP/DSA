#include<iostream>
#include<vector>
using namespace std;

 int main(){
    vector<int> nums= {1,0,1,0,1,0,0};
    int n=nums.size();
    int i=0, j=n-1; 
    while(i<j){
        if(nums[i] == 0) {
            i++;
            
        }
        else if(nums[j]  == 1) {
            j--;
            
        }
        else{
            swap(nums[i],nums[j]);
        }
    }
    for(int ele: nums) cout<<ele<<" ";
}
