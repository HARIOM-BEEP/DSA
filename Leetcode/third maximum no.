class Solution {
public:
    int thirdMax(vector<int>& nums) {
        int n=nums.size();
        int max=INT_MIN; 
        int smax=INT_MIN;
        int tmax=INT_MIN;
        bool flag=false;
        for(int i=0; i<n ; i++){
            if(nums[i]>max){
                max=nums[i];
            }
        }
        for(int i=0; i<n ; i++){
            if(nums[i]>=smax && nums[i]!=max){
                smax=nums[i];
            }
        }
        for(int i=0; i<n ; i++){
            if(nums[i]>=tmax && nums[i]!=max && nums[i]!=smax){
                tmax=nums[i];
                flag=true;
            }
        }
        if(flag==true) return tmax;
        else return max;
    }
};
